{
  "name": "fanpost",
  "version": "1.0.2",
  "description": "浪叉多平台发布助手：一份内容一键填写、发布到多个自媒体平台",
  "main": "dist-electron/main/index.js",
  "author": "Jackie",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/main/persistent-store.test.mjs src/main/ffmpeg.test.ts src/main/cover-border.test.ts src/main/publish-verification.test.ts src/main/notify-core.test.ts src/main/accounts.test.ts src/main/history.test.ts src/main/login-rules.test.ts src/shared/topics.test.ts src/shared/drafts.test.ts src/shared/declarations.test.ts src/shared/content-check.test.ts src/shared/task-outcome.test.ts src/shared/license.test.ts src/shared/app-info.test.ts src/main/publish-control.test.ts src/main/publish-scheduler.test.ts src/shared/mp-health.test.ts src/shared/mp-rules.test.ts src/main/sealed.test.ts src/shared/import-fit.test.ts src/shared/note-import.test.ts src/shared/tutorial.test.ts",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@fontsource-variable/geist": "5.2.8",
    "@fontsource-variable/geist-mono": "5.2.7",
    "@napi-rs/canvas": "1.0.2",
    "antd": "^6.1.3",
    "cheerio": "^1.2.0",
    "ffmpeg-static": "^5.3.0",
    "iconv-lite": "^0.6.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "marked": "^18.0.5",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "jimp": "^1.6.1",
    "png-to-ico": "^3.0.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  },
  "build": {
    "appId": "com.fanpost.app",
    "productName": "浪叉多平台发布助手",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/ffmpeg-static/ffmpeg.exe",
      "!node_modules/ffmpeg-static/ffmpeg.exe.*"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      },
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "使用教程.md",
          "images/**/*"
        ]
      }
    ],
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "compression": "maximum",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "FanPost-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "removePackageScripts": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true
    },
    "asarUnpack": [
      "node_modules/@napi-rs/**"
    ]
  },
  "homepage": "https://github.com/Tom-wc/FanPost#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tom-wc/FanPost.git"
  }
}
